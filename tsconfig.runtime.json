{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "src/**/*.ts",
    "src/runtime/**/*.mjs",
    "examples/**/*.ts"
  ]
}
